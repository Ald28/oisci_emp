generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id       Int     @id @default(autoincrement())
  userCode String  @unique
  name     String
  email    String  @unique
  password String
  active   Boolean @default(true)

  extintoresCreados Extintor[] @relation("ExtintorUsuarioCreador")

  serviciosCreados      Servicio[] @relation("ServicioUsuarioCreador")
  serviciosActualizados Servicio[] @relation("ServicioUsuarioActualizador")
  serviciosAsignados    Servicio[] @relation("ServicioAsignado")

  createdById   Int?
  createdBy     User?          @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers  User[]         @relation("UserCreator")
  updatedById   Int?
  updatedBy     User?          @relation("UserUpdater", fields: [updatedById], references: [id])
  updatedUsers  User[]         @relation("UserUpdater")
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  clients       Client[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  serviciosExtintorCreados ServicioExtintor[] @relation("ServicioExtintorUsuarioCreador")
  serviciosExtintorActualizados ServicioExtintor[] @relation("ServicioExtintorUsuarioActualizador")

  mantenimientosDetalleCreados MantenimientoDetalle[] @relation("MantenimientoDetalleUsuarioCreador")
  mantenimientosDetalleActualizados MantenimientoDetalle[] @relation("MantenimientoDetalleUsuarioActualizador")

  inspeccionesDetalleCreados      InspeccionDetalle[] @relation("InspeccionDetalleUsuarioCreador")
  inspeccionesDetalleActualizados InspeccionDetalle[] @relation("InspeccionDetalleUsuarioActualizador")

  reportesCreados      Reporte[] @relation("ReporteUsuarioCreador")
  reportesActualizados Reporte[] @relation("ReporteUsuarioActualizador")
  reportesAprobados    Reporte[] @relation("ReporteAprobador")

  certificadosAprobados Certificado[] @relation("CertificadoAprobador")
  certificadosCreados   Certificado[] @relation("CertificadoUsuarioCreador")
  certificadosActualizados Certificado[] @relation("CertificadoUsuarioActualizador")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Client {
  id          Int      @id @default(autoincrement())
  clientCode  String   @unique
  razonSocial String
  ruc         String   @unique @db.VarChar(11)
  phone       String
  address     String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sedes       Sede[]
  certificados Certificado[]
}

model Reporte {
  id Int @id @default(autoincrement())

  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  tipo ReporteTipo

  fechaEmision DateTime?

  emitido ReporteEmitido @default(NO)

  frecuencia String? @db.VarChar(45)

  aprobadoPorId Int?
  aprobadoPor   User? @relation("ReporteAprobador", fields: [aprobadoPorId], references: [id])

  archivoPdfUrl String? @db.VarChar(255)

  usuarioCreadorId Int
  usuarioCreador   User @relation("ReporteUsuarioCreador", fields: [usuarioCreadorId], references: [id])

  usuarioActualizadorId Int?
  usuarioActualizador   User? @relation("ReporteUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  servicioReportes ServicioReporte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([servicioId])
}

model ServicioReporte {
  id Int @id @default(autoincrement())

  estado StatusEnum?

  checklist Json

  reporteId Int
  reporte   Reporte @relation(fields: [reporteId], references: [id])

  extintorId Int
  extintor   Extintor @relation(fields: [extintorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporteId])
  @@index([extintorId])
  @@unique([reporteId, extintorId])
}

enum ReporteTipo {
  FOTO
  INSPECCION
}

enum ReporteEmitido {
  SI
  NO
}

model Certificado {
  id Int @id @default(autoincrement())

  tipo CertificadoTipo

  numeroCertificado String @db.VarChar(45)

  fechaEmision DateTime?

  emitido CertificadoEmitido @default(NO)

  frecuencia String? @db.VarChar(45)

  archivoPdfUrl String? @db.VarChar(255)

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  sedeId Int
  sede   Sede @relation(fields: [sedeId], references: [id])

  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  aprobadorId Int?
  aprobador   User? @relation("CertificadoAprobador", fields: [aprobadorId], references: [id])

  usuarioCreadorId Int
  usuarioCreador   User @relation("CertificadoUsuarioCreador", fields: [usuarioCreadorId], references: [id])

  usuarioActualizadorId Int?
  usuarioActualizador   User? @relation("CertificadoUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  certificadoDetalles CertificadoDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([sedeId])
  @@index([servicioId])
  @@index([aprobadorId])
}

enum CertificadoTipo {
  OPER
  HIDRO
  BAJA
}

enum CertificadoEmitido {
  SI
  NO
}

model CertificadoDetalle {
  id Int @id @default(autoincrement())

  estado StatusEnum?

  checklist Json

  certificadoId Int
  certificado   Certificado @relation(fields: [certificadoId], references: [id])

  extintorId Int
  extintor   Extintor @relation(fields: [extintorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([certificadoId])
  @@index([extintorId])
  @@unique([certificadoId, extintorId])
}

model Sede {
  id            Int        @id @default(autoincrement())
  name_sede     String
  address       String
  manager_name  String
  manager_phone String
  manager_email String
  city          String
  active        Boolean    @default(true)
  clientId      Int
  client        Client     @relation(fields: [clientId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  extintores    Extintor[]
  servicios     Servicio[]
  certificados Certificado[]
  @@unique([clientId, name_sede])
}

model Extintor {
  id               Int        @id @default(autoincrement())
  codeNFC          String?    @unique @db.VarChar(45)
  serialNumber     String?    @db.VarChar(45)
  type             String?    @db.VarChar(45)
  capacity         String?    @db.VarChar(45)
  agent            String?    @db.VarChar(45)
  cylinderNumber   String?    @db.VarChar(45)
  location         String?    @db.VarChar(45)
  status           StatusEnum?
  historic         Int?

  pressure         String?    @db.VarChar(255)
  brand            String?    @db.VarChar(255)
  model            String?    @db.VarChar(255)
  rating           String?    @db.VarChar(255)
  yearManufacture  String?    @db.VarChar(255)
  dateHydrostatic  String?    @db.VarChar(255)
  dateMaintenance  String?    @db.VarChar(255)
  
  dateLow          DateTime?
  photo            String?    @db.VarChar(255)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  sedeId           Int
  usuarioCreadorId Int

  sede             Sede @relation(fields: [sedeId], references: [id])
  servicioReportes ServicioReporte[]

  usuarioCreador   User @relation("ExtintorUsuarioCreador", fields: [usuarioCreadorId], references: [id])

  serviciosExtintor ServicioExtintor[]

  certificadoDetalles CertificadoDetalle[]
}

enum StatusEnum {
  OPERATIVO
  INOPERATIVO
}

model Servicio {
  id           Int           @id @default(autoincrement())
  type         TypeService
  dateStart    DateTime
  dateEnd      DateTime?
  sincronizado Boolean       @default(false)
  status       ServiceStatus
  statusValid  ServiceValid
  historic     String?       @db.VarChar(45)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  sedeId Int
  userId Int

  sede                Sede  @relation(fields: [sedeId], references: [id])
  usuarioCreador      User  @relation("ServicioUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("ServicioUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  user                User @relation("ServicioAsignado", fields: [userId], references: [id])

  servicioExtintores ServicioExtintor[]

  reportes Reporte[]

  certificados Certificado[]

  @@unique([sedeId, type, dateStart])
}

enum TypeService {
  MANTENIMIENTO
  INSPECCION
}

enum ServiceStatus {
  EN_PROCESO
  FINALIZADO
}

enum ServiceValid {
  APROBADO
  RECHAZADO
}

model ServicioExtintor {
  id Int @id @default(autoincrement())

  codeServ   String @default("")

  servicioId Int
  extintorId Int

  servicio Servicio @relation(fields: [servicioId], references: [id])
  extintor Extintor @relation(fields: [extintorId], references: [id])

  estadoInicial StatusEnum?
  estadoFinal   StatusEnum?
  completado    Boolean @default(false)

  observaciones String? @db.VarChar(255)

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  usuarioCreador      User  @relation("ServicioExtintorUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("ServicioExtintorUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantenimientoDetalle MantenimientoDetalle?
  inspeccionDetalle   InspeccionDetalle?

  @@unique([servicioId, extintorId])
}

model MantenimientoDetalle {
  id Int @id @default(autoincrement())

  servicioExtintorId Int
  servicioExtintor   ServicioExtintor @relation(fields: [servicioExtintorId], references: [id])

  mantenimiento        Boolean @default(false)
  recarga              Boolean @default(false)
  agenteCarga          String? @db.VarChar(45)
  pruebaHidrostatica   Boolean @default(false)
  bajaExtintor         Boolean @default(false)
  motivoBaja           String? @db.VarChar(255)
  pintura              Boolean @default(false)
  recargaCartucho      Boolean @default(false)
  cambioPartes         Boolean @default(false)
  detallesCambioPartes  String? @db.VarChar(255)

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  usuarioCreador      User  @relation("MantenimientoDetalleUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("MantenimientoDetalleUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([servicioExtintorId])
}

model InspeccionDetalle {
  id Int @id @default(autoincrement())

  servicioExtintorId Int
  servicioExtintor   ServicioExtintor @relation(fields: [servicioExtintorId], references: [id])

  foto1Url String? @db.VarChar(255)
  foto2Url String? @db.VarChar(255)
  foto3Url String? @db.VarChar(255)

  visibilidad   String? @db.VarChar(45)
  visualizacion String? @db.VarChar(45)
  accesibilidad String? @db.VarChar(45)
  altura        String? @db.VarChar(45)
  situacion     String? @db.VarChar(45)
  conservacion  String? @db.VarChar(45)
  inscripciones String? @db.VarChar(45)
  recorrido     String? @db.VarChar(45)
  peso          String? @db.VarChar(45)

  observaciones String? @db.VarChar(255)

  Ubicación     String? @db.VarChar(255)
  Acceso        String? @db.VarChar(255)
  Fijación      String? @db.VarChar(255)
  Uso           String? @db.VarChar(255)
  Clase         String? @db.VarChar(255)
  Recarga       String? @db.VarChar(255)
  Hidrostática  String? @db.VarChar(255)
  Presión       String? @db.VarChar(255)
  Precinto      String? @db.VarChar(255)
  Cilindro      String? @db.VarChar(255)
  Carga         String? @db.VarChar(255)
  Soporte       String? @db.VarChar(255)
  Manija        String? @db.VarChar(255)
  Manguera      String? @db.VarChar(255)
  Tobera        String? @db.VarChar(255)
  Abrazadera    String? @db.VarChar(255)

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  usuarioCreador      User  @relation("InspeccionDetalleUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("InspeccionDetalleUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([servicioExtintorId])
}