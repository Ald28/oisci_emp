generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id       Int     @id @default(autoincrement())
  userCode String  @unique
  name     String
  email    String  @unique
  password String
  active   Boolean @default(true)

  extintoresCreados Extintor[] @relation("ExtintorUsuarioCreador")

  serviciosCreados      Servicio[] @relation("ServicioUsuarioCreador")
  serviciosActualizados Servicio[] @relation("ServicioUsuarioActualizador")
  serviciosAsignados    Servicio[] @relation("ServicioAsignado")

  createdById   Int?
  createdBy     User?          @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers  User[]         @relation("UserCreator")
  updatedById   Int?
  updatedBy     User?          @relation("UserUpdater", fields: [updatedById], references: [id])
  updatedUsers  User[]         @relation("UserUpdater")
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  clients       Client[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  serviciosExtintorCreados ServicioExtintor[] @relation("ServicioExtintorUsuarioCreador")
  serviciosExtintorActualizados ServicioExtintor[] @relation("ServicioExtintorUsuarioActualizador")

  mantenimientosDetalleCreados MantenimientoDetalle[] @relation("MantenimientoDetalleUsuarioCreador")
  mantenimientosDetalleActualizados MantenimientoDetalle[] @relation("MantenimientoDetalleUsuarioActualizador")

  inspeccionesDetalleCreados      InspeccionDetalle[] @relation("InspeccionDetalleUsuarioCreador")
  inspeccionesDetalleActualizados InspeccionDetalle[] @relation("InspeccionDetalleUsuarioActualizador")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Client {
  id          Int      @id @default(autoincrement())
  clientCode  String   @unique
  razonSocial String
  ruc         String   @unique @db.VarChar(11)
  phone       String
  address     String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sedes       Sede[]
}

model Sede {
  id            Int        @id @default(autoincrement())
  name_sede     String
  address       String
  manager_name  String
  manager_phone String
  manager_email String
  city          String
  active        Boolean    @default(true)
  clientId      Int
  client        Client     @relation(fields: [clientId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  extintores    Extintor[]
  servicios     Servicio[]
  @@unique([clientId, name_sede])
}

model Extintor {
  id               Int        @id @default(autoincrement())
  codeNFC          String?    @unique @db.VarChar(45)
  serialNumber     String?    @db.VarChar(45)
  type             String?    @db.VarChar(45)
  capacity         String?    @db.VarChar(45)
  agent            String?    @db.VarChar(45)
  cylinderNumber   String?    @db.VarChar(45)
  location         String?    @db.VarChar(45)
  status           StatusEnum?
  historic         Int?
  dateLow          DateTime?
  photo            String?    @db.VarChar(45)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  sedeId           Int
  usuarioCreadorId Int

  sede             Sede @relation(fields: [sedeId], references: [id])
  usuarioCreador   User @relation("ExtintorUsuarioCreador", fields: [usuarioCreadorId], references: [id])

  serviciosExtintor ServicioExtintor[]
}

enum StatusEnum {
  OPERATIVO
  INOPERATIVO
}

model Servicio {
  id           Int           @id @default(autoincrement())
  type         TypeService
  dateStart    DateTime
  dateEnd      DateTime?
  sincronizado Boolean       @default(false)
  status       ServiceStatus
  statusValid  ServiceValid
  historic     String?       @db.VarChar(45)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  sedeId Int
  userId Int

  sede                Sede  @relation(fields: [sedeId], references: [id])
  usuarioCreador      User  @relation("ServicioUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("ServicioUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])
  user                User @relation("ServicioAsignado", fields: [userId], references: [id])

  servicioExtintores ServicioExtintor[]

  @@unique([sedeId, type, dateStart])
}

enum TypeService {
  MANTENIMIENTO
  INSPECCION
}

enum ServiceStatus {
  EN_PROCESO
  FINALIZADO
}

enum ServiceValid {
  APROBADO
  RECHAZADO
}

model ServicioExtintor {
  id Int @id @default(autoincrement())

  codeServ   String @default("")

  servicioId Int
  extintorId Int

  servicio Servicio @relation(fields: [servicioId], references: [id])
  extintor Extintor @relation(fields: [extintorId], references: [id])

  estadoInicial StatusEnum?
  estadoFinal   StatusEnum?
  completado    Boolean @default(false)

  observaciones String? @db.VarChar(255)

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  usuarioCreador      User  @relation("ServicioExtintorUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("ServicioExtintorUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantenimientoDetalle MantenimientoDetalle?
  inspeccionDetalle   InspeccionDetalle?

  @@unique([servicioId, extintorId])
}

model MantenimientoDetalle {
  id Int @id @default(autoincrement())

  servicioExtintorId Int
  servicioExtintor   ServicioExtintor @relation(fields: [servicioExtintorId], references: [id])

  mantenimiento        Boolean @default(false)
  recarga              Boolean @default(false)
  agenteCarga          String? @db.VarChar(45)
  pruebaHidrostatica   Boolean @default(false)
  bajaExtintor         Boolean @default(false)
  motivoBaja           String? @db.VarChar(255)
  pintura              Boolean @default(false)
  recargaCartucho      Boolean @default(false)
  cambioPartes         Boolean @default(false)

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  usuarioCreador      User  @relation("MantenimientoDetalleUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("MantenimientoDetalleUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([servicioExtintorId])
}

model InspeccionDetalle {
  id Int @id @default(autoincrement())

  servicioExtintorId Int
  servicioExtintor   ServicioExtintor @relation(fields: [servicioExtintorId], references: [id])

  foto1Url String? @db.VarChar(45)
  foto2Url String? @db.VarChar(45)
  foto3Url String? @db.VarChar(45)

  visibilidad   String? @db.VarChar(45)
  visualizacion String? @db.VarChar(45)
  accesibilidad String? @db.VarChar(45)
  altura        String? @db.VarChar(45)
  situacion     String? @db.VarChar(45)
  conservacion  String? @db.VarChar(45)
  inscripciones String? @db.VarChar(45)
  recorrido     String? @db.VarChar(45)
  peso          String? @db.VarChar(45)

  observaciones String? @db.VarChar(255)

  usuarioCreadorId      Int
  usuarioActualizadorId Int?

  usuarioCreador      User  @relation("InspeccionDetalleUsuarioCreador", fields: [usuarioCreadorId], references: [id])
  usuarioActualizador User? @relation("InspeccionDetalleUsuarioActualizador", fields: [usuarioActualizadorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([servicioExtintorId])
}