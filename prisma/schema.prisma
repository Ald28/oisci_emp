generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id       Int     @id @default(autoincrement())
  userCode String  @unique
  name     String
  email    String  @unique
  password String
  active   Boolean @default(true)

  extintoresCreados Extintor[] @relation("ExtintorUsuarioCreador")

  createdById   Int?
  createdBy     User?          @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers  User[]         @relation("UserCreator")
  updatedById   Int?
  updatedBy     User?          @relation("UserUpdater", fields: [updatedById], references: [id])
  updatedUsers  User[]         @relation("UserUpdater")
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  clients       Client[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Client {
  id          Int      @id @default(autoincrement())
  clientCode  String   @unique
  razonSocial String
  ruc         String   @unique @db.VarChar(11)
  phone       String
  address     String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sedes       Sede[]
}

model Sede {
  id            Int        @id @default(autoincrement())
  name_sede     String
  address       String
  manager_name  String
  manager_phone String
  manager_email String
  city          String
  active        Boolean    @default(true)
  clientId      Int
  client        Client     @relation(fields: [clientId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  extintores    Extintor[]
}

model Extintor {
  id               Int         @id @default(autoincrement())
  codeNFC          String?     @unique @db.VarChar(45)
  serialNumber     String?     @db.VarChar(45)
  type             String?     @db.VarChar(45)
  capacity         String?     @db.VarChar(45)
  agent            String?     @db.VarChar(45)
  cylinderNumber   String?     @db.VarChar(45)
  location         String?     @db.VarChar(45)
  status           StatusEnum?
  historic         String?     @db.VarChar(45)
  dateLow          String?     @db.VarChar(45)
  photo            String?     @db.VarChar(45)
  createdAt        DateTime?   @default(now())
  updatedAt        DateTime?   @updatedAt
  sedeId           Int
  usuarioCreadorId Int

  sede           Sede @relation(fields: [sedeId], references: [id])
  usuarioCreador User @relation("ExtintorUsuarioCreador", fields: [usuarioCreadorId], references: [id])
}

enum StatusEnum {
  OPERATIVO
  INOPERATIVO
}